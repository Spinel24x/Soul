# Copy to .env and adjust. All are optional (sensible defaults exist).
# FORGE_PROTOCOLS=vless-ws,trojan-ws,vless-xhttp
# FORGE_PATH_PREFIX=forge
# FORGE_REMARK=forge
# Codespace runtime knobs (used by runtimes/codespace/start.sh):
# PROTOCOLS=vless-ws
# SERVE_SUB=1
# SUB_PORT=9000
# VPS (REALITY) knobs (used by runtimes/vps/setup.sh):
# PORT=443
# DEST=www.microsoft.com:443
# SNI=www.microsoft.com
